# Auto-detect text files and normalize line endings to LF on commit
* text=auto eol=lf

# ─── Godot text resources — always LF ─────────────────────────
*.gd          text eol=lf
*.tscn        text eol=lf
*.tres        text eol=lf
*.godot       text eol=lf
*.cfg         text eol=lf
*.import      text eol=lf
*.gdshader    text eol=lf
*.gdshaderinc text eol=lf

# ─── Docs / config ────────────────────────────────────────────
*.md          text eol=lf
*.json        text eol=lf
*.yaml        text eol=lf
*.yml         text eol=lf
*.toml        text eol=lf
*.xsb         text eol=lf

# ─── Binary assets ────────────────────────────────────────────
*.png         binary
*.jpg         binary
*.jpeg        binary
*.webp        binary
*.svg         text eol=lf
*.ogg         binary
*.wav         binary
*.mp3         binary
*.ttf         binary
*.otf         binary
*.woff        binary
*.woff2       binary

# ─── Diff hint for .tscn (helps GitHub render diffs) ──────────
*.tscn linguist-language=GDScript
