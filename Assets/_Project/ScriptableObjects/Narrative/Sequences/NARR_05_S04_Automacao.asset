  m_Script: {fileID: 11500000, guid: cc1a559031194924283ac8701b8b04cf, type: 3}
  m_Name: NARR_05_S04_Automacao
  m_EditorClassIdentifier: TW08.Runtime::TW08.Narrative.NarrativeSequence
  sequenceId: narr-setor-s04
  title: "Setor 04 \u2014 Automa\xE7\xE3o"
  trigger: 2
  sectorId: S04
  levelId: 
  priority: 0
  playOnce: 1
  defaultCharactersPerSecond: 38
  lines:
  - speakerId: sistema
    text: "Bem-vindo ao setor de automa\xE7\xE3o. Efici\xEAncia operacional: 99,4%."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Noventa e nove v\xEDrgula quatro. E o armaz\xE9m inteiro travado."
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: Essas esteiras ligam sozinhas de madrugada. Rodam vazias e desligam.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Rodam vazias para quem olha o mapa.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: duda
    text: "Se o sistema insiste em uma rota, pergunte por que ele quer tanto que
      voc\xEA v\xE1 por ali."
    tone: 4
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Estou perguntando, Duda. Tarde, mas estou.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
