  m_Script: {fileID: 11500000, guid: cc1a559031194924283ac8701b8b04cf, type: 3}
  m_Name: NARR_05_S04_Automacao
  m_EditorClassIdentifier: TW08.Runtime::TW08.Narrative.NarrativeSequence
  sequenceId: narr-setor-s04
  title: "Setor 04 \u2014 Automa\xE7\xE3o"
  trigger: 2
  sectorId: S04
  levelId: 
  priority: 0
  playOnce: 1
  defaultCharactersPerSecond: 38
  lines:
  - speakerId: sistema
    text: "Bem-vindo ao setor de automa\xE7\xE3o. Efici\xEAncia operacional: 99,4%."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Noventa e nove v\xEDrgula quatro. E o armaz\xE9m inteiro travado."
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: Essas esteiras ligam sozinhas de madrugada. Rodam vazias e desligam.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Vazias no mapa. Algu\xE9m devia conferir se est\xE3o vazias no ch\xE3o."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "As aut\xF4nomas nunca entram no corredor C. Contornam. Sempre contornaram."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "M\xE1quina n\xE3o tem medo. M\xE1quina tem instru\xE7\xE3o."
    tone: 2
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: duda
    text: "Erro n\xE3o se repete com esse capricho. Isso n\xE3o \xE9 falha, \xE9
      padr\xE3o."
    tone: 4
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Padr\xE3o. Ela falava essa palavra que nem quem reza."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
