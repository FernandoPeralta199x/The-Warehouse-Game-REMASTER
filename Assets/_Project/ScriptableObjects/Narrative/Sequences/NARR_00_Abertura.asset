MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: cc1a559031194924283ac8701b8b04cf, type: 3}
  m_Name: NARR_00_Abertura
  m_EditorClassIdentifier: TW08.Runtime::TW08.Narrative.NarrativeSequence
  sequenceId: narr-abertura
  title: "Turno de Emerg\xEAncia"
  trigger: 1
  sectorId: 
  levelId: TW08_Level01_FirstShift
  priority: 10
  playOnce: 1
  defaultCharactersPerSecond: 38
  lines:
  - speakerId: sistema
    text: "Armaz\xE9m N\xBA 08. Falha operacional detectada."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: sistema
    text: "Rota n\xE3o autorizada. Setor indispon\xEDvel."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: sistema
    text: "Operador manual necess\xE1rio."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Tr\xEAs e dez da manh\xE3. Claro que sou eu."
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Bom, John... pelo menos hoje n\xE3o t\xE1 mon\xF3tono."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "S\xF3 me diga que ainda temos energia."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Temos algo parecido com energia. N\xE3o recomendo elogiar."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Me abre o Recebimento. Eu empurro o resto.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "J\xE1 t\xE1 aberto. Foi a \xFAnica porta que o sistema n\xE3o teve coragem
      de trancar."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "A escala do turno ainda est\xE1 pregada na parede?"
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Est\xE1. Com dois nomes."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: O meu e o seu.
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
