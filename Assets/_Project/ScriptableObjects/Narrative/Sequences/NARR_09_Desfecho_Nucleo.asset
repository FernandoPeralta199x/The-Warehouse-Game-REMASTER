  m_Script: {fileID: 11500000, guid: cc1a559031194924283ac8701b8b04cf, type: 3}
  m_Name: NARR_09_Desfecho_Nucleo
  m_EditorClassIdentifier: TW08.Runtime::TW08.Narrative.NarrativeSequence
  sequenceId: narr-desfecho-nucleo
  title: "N\xFAcleo Log\xEDstico"
  trigger: 5
  sectorId: 
  levelId: TW08_Level30_LogisticsCore
  priority: 10
  playOnce: 1
  defaultCharactersPerSecond: 38
  lines:
  - speakerId: sistema
    text: "N\xFAcleo log\xEDstico restaurado. Rotas consolidadas."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: sistema
    text: "Registro hist\xF3rico recuperado: escala do turno da noite."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: terminal
    text: "Hayes, R.  \u2014  Miller, J.  \u2014  Rocha, M. E.  \u2014  Elias."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Quatro nomes.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "De manh\xE3 tinha dois."
    tone: 2
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: duda
    text: "Eles n\xE3o esconderam os dados em arquivos. Esconderam nas rotas."
    tone: 4
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: duda
    text: "Eu sabia que voc\xEA ia demorar."
    tone: 4
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: duda
    text: "Voc\xEA nunca deixou um turno pela metade. Nem quando devia."
    tone: 4
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Demorei, Duda. Demorei demais.
    tone: 2
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "A oficina est\xE1 com energia, John. O que voc\xEA quiser abrir daqui,
      abre."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Modo manual.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: sistema
    text: "Comando n\xE3o reconhecido."
    tone: 3
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Vai reconhecer.
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
