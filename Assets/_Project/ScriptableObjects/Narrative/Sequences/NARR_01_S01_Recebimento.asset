  lines:
  - speakerId: john
    text: Recebimento. Cada caixa aqui devia ter uma etiqueta e um destino.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Metade n\xE3o tem nem uma coisa nem outra."
    tone: 1
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: O sistema ficou remanejando carga a noite inteira, John. Sozinho, no escuro.
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: Remanejando ou procurando?
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: ...
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Empurra a caixa, veterano. Pergunta dif\xEDcil a gente faz depois do caf\xE9."
    tone: 0
    charactersPerSecond: 0
