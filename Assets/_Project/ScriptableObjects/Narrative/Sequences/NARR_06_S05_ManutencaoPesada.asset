  m_Name: NARR_06_S05_ManutencaoPesada
  m_EditorClassIdentifier: TW08.Runtime::TW08.Narrative.NarrativeSequence
  sequenceId: narr-setor-s05
  title: "Setor 05 \u2014 Manuten\xE7\xE3o Pesada"
  trigger: 2
  sectorId: S05
  levelId: 
  priority: 0
  playOnce: 1
  defaultCharactersPerSecond: 38
  lines:
  - speakerId: robert
    text: "Oficina N-8. Cuidado com o degrau \u2014 ele nunca foi automatizado."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "Voc\xEA est\xE1 aqui embaixo esse tempo todo?"
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Desde o lockdown. O sistema esqueceu de me apagar. Eu n\xE3o reclamei."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: john
    text: "As m\xE1quinas velhas ainda andam?"
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Andam. S\xE3o as \xFAnicas aqui que n\xE3o aprenderam a mentir."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
  - speakerId: robert
    text: "Pega a chave inglesa, John. A partir daqui a gente abre no bra\xE7o."
    tone: 0
    charactersPerSecond: 0
    minimumDisplaySeconds: 0.45
    voiceEventId: 
